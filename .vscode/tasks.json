{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "构建项目 (x64 Debug)",
            "type": "process",
            "command": "D:/Program Files/Microsoft Visual Studio/2022/Community/MSBuild/Current/Bin/MSBuild.exe",
            "args": [
                "${workspaceFolder}/ProjectoneTest.sln",
                "/t:Build",
                "/p:Configuration=Debug",
                "/p:Platform=x64",
                "/m"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        }
    ]
}
